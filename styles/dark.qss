QWidget {
    background-color: #1e2229;
    color: #e7eaf0;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow,
QDialog {
    background-color: #1e2229;
    color: #e7eaf0;
}

QLineEdit,
QTextEdit,
QDateTimeEdit,
QComboBox,
QSpinBox {
    background-color: #282d36;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #5b7cdb;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #6f8fe8;
}

QComboBox {
    padding-right: 28px;
}

QComboBox QAbstractItemView {
    background-color: #282d36;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    selection-background-color: #3b4f82;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #282d36;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    border-radius: 8px;
    padding: 9px 15px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #333a46;
}

QPushButton:pressed {
    background-color: #3a424f;
}

QPushButton:disabled {
    background-color: #252a32;
    color: #707784;
}

QListView {
    background-color: #252a32;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListView::item {
    border-radius: 8px;
    padding: 4px;
}

QListView::item:hover {
    background-color: #303640;
}

QListView::item:selected {
    background-color: #344873;
    color: #ffffff;
}

QLabel {
    color: #e7eaf0;
}

QCheckBox {
    color: #e7eaf0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
}

QCheckBox::indicator:unchecked {
    background-color: #282d36;
    border: 1px solid #4a5361;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #5b7cdb;
    border: 1px solid #5b7cdb;
    border-radius: 4px;
}

QGroupBox {
    background-color: #252a32;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #aeb6c4;
}

QDialogButtonBox {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #20252c;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #4a5361;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5b6574;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #20252c;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #4a5361;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5b6574;
}

QCalendarWidget {
    background-color: #282d36;
    color: #e7eaf0;
}

QCalendarWidget QToolButton {
    color: #e7eaf0;
    background-color: #333943;
    border: none;
    border-radius: 5px;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #404754;
}

QCalendarWidget QMenu {
    background-color: #282d36;
    color: #e7eaf0;
}

QCalendarWidget QSpinBox {
    background-color: #282d36;
    color: #e7eaf0;
}

QCalendarWidget QAbstractItemView {
    background-color: #282d36;
    color: #e7eaf0;
    selection-background-color: #5b7cdb;
    selection-color: #ffffff;
    alternate-background-color: #242931;
}

QToolTip {
    background-color: #282d36;
    color: #e7eaf0;
    border: 1px solid #4a5361;
    padding: 6px;
}

QMenu {
    background-color: #282d36;
    color: #e7eaf0;
    border: 1px solid #3d4552;
    padding: 5px;
}

QMenu::item {
    padding: 7px 28px 7px 10px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #344873;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3d4552;
    margin: 5px 8px;
}